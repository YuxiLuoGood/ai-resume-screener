# Copy this file to .env and edit as needed. Every value is optional.

# Local LLM served by Ollama (run `ollama pull <model>` first).
# qwen2.5:7b is noticeably more accurate if your machine can run it.
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# How many files to check at the same time. Raise it only if Ollama runs with OLLAMA_NUM_PARALLEL > 1.
SCREEN_WORKERS=2

# Context window passed to Ollama (its default is small and silently cuts long prompts)
NUM_CTX=8192
# Files up to about this many tokens (a 1–3 page résumé) are sent to the model in full.
# Longer files are split into passages and only the most relevant ones are sent.
FULL_CONTEXT_TOKENS=4000
TOP_K=6
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Only used for long files. Downloaded on first use (about 470 MB).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# If Hugging Face downloads are slow or blocked, uncomment:
# HF_ENDPOINT=https://hf-mirror.com

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MAX_FILE_MB=20
MAX_FILES_PER_BATCH=200
MAX_BATCHES=10
